# Datos del producto y del titular. Se usan en el plugin, el instalador y los textos legales.
# Cambia estos valores y vuelve a compilar; todo se actualiza solo.

# Nombre de archivos y el que ve el DAW (sin acentos para que se vea bien en cualquier DAW)
PRODUCT_NAME="Dembow Clasico"
# Nombre que se muestra en la interfaz y en el instalador
DISPLAY_NAME="Dembow Clásico"
COMPANY_NAME="ECO Audio"
BUNDLE_ID="com.ecoaudio.dembowclasico"

# Contacto que aparece en la licencia (deja vacío lo que no quieras mostrar)
CONTACT_EMAIL=""
WEBSITE=""

# Archivo público que el plugin revisa (máximo una vez al día) para avisar que hay una versión nueva.
# Déjalo vacío para que el plugin nunca se conecte a internet.
UPDATE_URL=""

# Leyes y tribunales que rigen la licencia
JURISDICTION_LAW="las leyes federales de los Estados Unidos Mexicanos"
JURISDICTION_COURTS="los tribunales competentes de Monterrey, Nuevo León, México"
